apiVersion: v1
kind: Secret
metadata:
  namespace: {{ cookiecutter.namespace }}
  name: restic
  labels:
    app.kubernetes.io/name: restic
type: Opaque
data:
  AWS_ACCOUNT_ID: <echo -n "VALUE" | base64 >
  AWS_ACCOUNT_KEY: <echo -n "VALUE" | base64 >
  RESTIC_PASSWORD: <echo -n "VALUE" | base64 >
  BUCKET_NAME: <echo -n "VALUE" | base64 >
  CLUSTER_NAME: <echo -n "{{ cookiecutter.cluster_name }}" | base64 >
