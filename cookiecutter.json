{
  "project_name": "K3s Project",
  "project_slug": "{{ cookiecutter.project_name.lower().replace(' ', '-') }}",
  "description": "A brief description of the project",
  "cluster_base_domain": "k3s.local",
  "app_domain": "{{ cookiecutter.project_slug }}",
  "namespace": "default",
  "role": ["unset", "Role", "ClusterRole"],
  "service_account": "{{ cookiecutter.project_slug }}-sa-{{ cookiecutter.role.lower() }}",
  "cluster_name": "k3s-cpv",
  "has_node_affinity": false,
  "image": "strm/helloworld-http",
  "image_version": "latest",
  "replicas": 1,
  "container_port": 8080,
  "has_liveness_probe": false,
  "has_configmap_env": true,
  "has_secret_env": false,
  "has_configmap_config": false,
  "configmap_config_path": "/PATH/IN/CONTAINER",
  "has_volume_0": false,
  "volume_0_name": "config",
  "volume_0_path": "/PATH/IN/CONTAINER",
  "has_volume_1": false,
  "volume_1_name": "data",
  "volume_1_path": "/PATH/IN/CONTAINER",
  "has_volume_2": false,
  "volume_2_name": "vol-2",
  "volume_2_path": "/PATH/IN/CONTAINER",
  "has_volume_3": false,
  "volume_3_name": "vol-3",
  "volume_3_path": "/PATH/IN/CONTAINER",
  "has_volume_4": false,
  "volume_4_name": "vol-4",
  "volume_4_path": "/PATH/IN/CONTAINER"
} 
