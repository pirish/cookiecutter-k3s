  "container_port": 8080,
  "has_liveness_probe": false,
  "has_configmap_env": true,
  "has_configmap_config": false,
  "has_volume_config": false,
  "config_volume_path": "/PATH/IN/CONTAINER",
  "has_volume_data": false,
  "data_volume_path": "/PATH/IN/CONTAINER",
  "has_volume_2": false,
  "data2_volume_path": "/PATH/IN/CONTAINER",
  "has_volume_3": false,
  "data3_volume_path": "/PATH/IN/CONTAINER"
} 
